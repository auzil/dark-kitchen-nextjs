# Copy to .env.local for local runs. On Vercel set these per environment (Production / Preview).

# Public origin, no trailing slash: metadata (canonical, hreflang, OG), sitemap, robots, JSON-LD. Required in production.
SITE_URL=https://example.cz

# Preview builds only: let placeholders (sample: true content, AI photos, missing settings) through the build,
# show the "Preview — not final" badge and noindex the site. Never set on Production.
ALLOW_PLACEHOLDERS=

# Newsletter / gift-code sign-up delivery. Owner decision pending: Brevo or Ecomail (TODO-OWNER "E-mail service").
# Implemented today: `log` (prints to the server log; used by `next dev` by default, allowed in production builds
# only together with ALLOW_PLACEHOLDERS=true). Production needs brevo|ecomail once its adapter exists in
# lib/delivery/newsletter.ts; until then the build guard lists this variable.
NEWSLETTER_PROVIDER=
# BREVO_API_KEY=        (when Brevo is chosen; server only)
# ECOMAIL_API_KEY=      (when Ecomail is chosen; server only)

# Sign-up (gift code) feature. On by default; `false` (or 0 / off) hides the sign-up section, its nav and hero
# links and the gift line, makes the Server Action refuse, and drops site.gift, media.gift and NEWSLETTER_PROVIDER
# from the build guard. Set it for build and runtime alike (the page is prerendered, the action reads it at runtime); changing it needs a redeploy.
FEATURE_SIGNUP=

# Google Analytics 4 measurement ID (G-XXXXXXX), see README "Analytics". gtag.js loads only after the visitor accepts the
# consent banner; with it unset neither the script nor the banner exists (previews, local runs). Required in production
# (the build guard lists it); inlined at build time, so changing it needs a rebuild.
NEXT_PUBLIC_GA_ID=
